# SERVER-ONLY secrets template. Copy to .env (gitignored) on trusted machines only.
# Used by services/coach-api and Supabase CLI env() substitution in supabase/config.toml.
#
# Nothing in this file may be prefixed EXPO_PUBLIC_, copied into app/, or bundled into the mobile app.
# Public mobile configuration lives in app/.env.example.

# --- Supabase (privileged) ---
SUPABASE_URL=http://127.0.0.1:54321
# Service-role/secret key bypasses RLS. Use only with explicit server-side ownership checks.
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-only

# --- Google OAuth for Supabase Auth (referenced from supabase/config.toml via env()) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-me
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-me-server-only

# --- Coach service (services/coach-api, Gemini) ---
# The coach verifies users and reads/writes data with the USER's token (RLS); it needs only the anon key.
SUPABASE_ANON_KEY=replace-me
# Only 'gemini' is a real provider. Missing key/model -> the service answers 503 coach_unavailable.
COACH_PROVIDER=gemini
GEMINI_API_KEY=replace-me-server-only
# Model is an open decision (O-08, docs/DECISIONS.md); keep it configurable, never hard-coded.
GEMINI_MODEL=replace-after-evaluation
# Total budget per draft request (seconds) and repairs (clamped to at most 1).
COACH_REQUEST_TIMEOUT_SECONDS=90
COACH_MAX_REPAIR_ATTEMPTS=1
COACH_MAX_OUTPUT_TOKENS=4096
COACH_MAX_CONTEXT_CHARS=12000
COACH_MAX_CANDIDATES=120
# In-process limits (per service process) on top of the database rate limit; operator budget cap (O-08).
# Can only lower the database limit (10/hour, enforced in coach_begin_request); values above 10 have no effect.
COACH_USER_REQUESTS_PER_HOUR=10
COACH_DAILY_REQUEST_CAP=200
# Optional override; defaults to app/assets/catalog/exercises.v1.json.
# COACH_CATALOG_PATH=
# Comma-separated browser origins allowed to call the coach API (Expo web dev server). Empty = no CORS.
# COACH_CORS_ORIGINS=http://localhost:8081
