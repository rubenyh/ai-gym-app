# Copy to app/.env.local (gitignored). Placeholders only.
#
# EVERY variable prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle and is
# readable by anyone who has the app. Only put values here that are safe to publish.
#
# NEVER add here (with or without EXPO_PUBLIC_): Supabase service-role/secret key,
# Gemini/Google GenAI API key, OAuth client secrets, database passwords.
# Those belong only in the server-side template: ../.env.example

# Supabase project URL. Local `supabase start` API port is 54321 (supabase/config.toml).
# Android emulator: use http://10.0.2.2:54321 (127.0.0.1 is the emulator itself).
# Physical device: use this computer's LAN IP. Web (npx expo start --web): http://127.0.0.1:54321; shell
# variables override this file, so one .env.local can keep the emulator value (docs/guides/SETUP.md, Web).
# Values: `supabase status` (repo root).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon / publishable key. Safe to ship ONLY because RLS protects every table and bucket.
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Coach API (FastAPI) base URL. Local default; the app sends the user's Supabase access token.
EXPO_PUBLIC_COACH_API_URL=http://127.0.0.1:8000
