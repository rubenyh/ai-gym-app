{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(npx eas-cli@latest submit:*)",
      "Bash(npx eas-cli@latest update:*)"
    ]
  }
}
